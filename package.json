{
  "name": "loomhr",
  "version": "1.0.5",
  "private": true,
  "description": "LoomHR — HRMS for textile, spinning, weaving & dyeing production units across India. Workforce master, shifts & attendance, day/weekly/monthly wages, incentives, agent commission, advances, health & welfare, payroll and an agentic AI daily briefing.",
  "main": "electron/main.js",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "db:migrate": "tsx scripts/migrate.ts",
    "db:seed": "tsx scripts/seed.ts",
    "db:reset": "npm run db:migrate && npm run db:seed",
    "db:push-tidb": "tsx scripts/push-to-tidb.ts",
    "electron": "electron .",
    "desktop:prepare": "next build && node scripts/prepare-standalone.mjs",
    "dist": "npm run desktop:prepare && electron-builder --win nsis --x64",
    "dist:win": "npm run desktop:prepare && electron-builder --win nsis --x64",
    "dist:mac": "npm run desktop:prepare && electron-builder --mac dmg zip",
    "dist:linux": "npm run desktop:prepare && electron-builder --linux AppImage",
    "dist:all": "npm run desktop:prepare && electron-builder -mwl"
  },
  "dependencies": {
    "@tanstack/react-query": "^5.64.0",
    "apexcharts": "^4.3.0",
    "clsx": "^2.1.1",
    "electron-updater": "^6.3.9",
    "exceljs": "^4.4.0",
    "jspdf": "^4.2.1",
    "lucide-react": "^0.469.0",
    "mysql2": "^3.23.2",
    "next": "15.1.6",
    "next-themes": "^0.4.4",
    "react": "^19.0.0",
    "react-apexcharts": "^1.7.0",
    "react-dom": "^19.0.0",
    "tailwind-merge": "^2.6.0",
    "zustand": "^5.0.3"
  },
  "devDependencies": {
    "@types/node": "^22",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "autoprefixer": "^10.4.20",
    "dotenv": "^17.4.2",
    "electron": "^41.7.1",
    "electron-builder": "^24.13.3",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.17",
    "tsx": "^4.23.1",
    "typescript": "^5.7.3"
  },
  "build": {
    "appId": "in.loomhr.desktop",
    "productName": "LoomHR",
    "files": [
      "electron/**/*"
    ],
    "extraResources": [
      {
        "from": ".next/standalone",
        "to": "app"
      }
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "shortcutName": "LoomHR",
      "include": "electron/installer.nsh",
      "deleteAppDataOnUninstall": false
    },
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64",
            "x64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "arm64",
            "x64"
          ]
        }
      ],
      "category": "public.app-category.business",
      "artifactName": "${productName}-${version}-${arch}.${ext}"
    },
    "dmg": {
      "title": "${productName} ${version}"
    },
    "linux": {
      "target": [
        "AppImage"
      ],
      "category": "Office"
    },
    "directories": {
      "output": "dist-desktop"
    },
    "publish": [
      {
        "provider": "github",
        "owner": "ai-agent-projetct",
        "repo": "HRMS",
        "releaseType": "release"
      }
    ]
  }
}
