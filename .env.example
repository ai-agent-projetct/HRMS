# LoomHR — database connection
# Copy to .env.local and adjust.
#
# NOTE: always quote passwords. An unquoted '#' starts a comment and would
# silently truncate the value (e.g. LoomHr#2026 -> LoomHr).

# --- Option A: local MySQL (app user created by db/setup.sql) ---
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=loomhr
DB_PASSWORD="LoomHr#2026"
DB_NAME=loomhr

# --- Option B: TiDB Cloud Serverless — access from anywhere ---
# From the cluster's "Connect" dialog. TLS is required and is enabled
# automatically for *.tidbcloud.com hosts (or force it with DB_SSL=true).
# DB_HOST=gateway01.<region>.prod.aws.tidbcloud.com
# DB_PORT=4000
# DB_USER=<prefix>.root
# DB_PASSWORD="<your-tidb-password>"
# DB_NAME=loomhr
# DB_SSL=true
